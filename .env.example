# APIShield Backend Environment Configuration (Placeholders only)

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Security and Sessions
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=change-this-to-a-secure-fernet-key-32-urlsafe-base64-bytes
SESSION_COOKIE_NAME=apishield_session
CSRF_COOKIE_NAME=apishield_csrf
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Database Configuration
# PostgreSQL connection string: postgresql+psycopg://user:password@localhost:5432/apishield
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apishield
DATABASE_ECHO=false

# CORS Configuration (Comma-separated list of allowed origins)
# Never use wildcards with credentials in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=20
